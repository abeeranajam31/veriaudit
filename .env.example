# VERIAUDIT — environment configuration example.
# Copy to .env in the relevant package (frontend/.env.local, backend/.env) and fill in real values.
# Never commit a real .env file.

# --- backend/.env ---
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=200000
SIMILARITY_FLAG_THRESHOLD=0.85
RATE_LIMIT_PER_MINUTE=30

# Optional — only needed if DEMO_MODE=false and you configure live model adapters.
HUGGINGFACE_API_TOKEN=
OPENAI_API_KEY=

# --- frontend/.env.local ---
# Base URL of a deployed VERIAUDIT backend. If unset, the frontend runs entirely
# in static DEMO MODE using the client-side pilot dataset.
NEXT_PUBLIC_API_URL=
